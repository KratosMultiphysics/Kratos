! ======================================================================
! Swift J2 validation - ANSYS Mechanical APDL
! Intended for ANSYS Mechanical APDL R19.2
! Units: N, mm, MPa
!
! Purpose:
!   Independent one-element validation of the Kratos
!   SmallStrainSwiftJ2Plasticity3DLaw.
!
! Constitutive target:
!   sigma_y = KSWIFT * (EPS0 + p)^NSWIFT
!   E       = 210000 MPa
!   nu      = 0.3
!   KSWIFT  = 1000 MPa
!   EPS0    = 0.01
!   NSWIFT  = 0.2
!
! ANSYS representation:
!   von Mises plasticity + multilinear isotropic hardening (MISO).
!   The exact Swift curve is sampled at 100 points, the documented
!   maximum number of TBPT points for PLASTIC,MISO. The table covers
!   p = 0 ... 0.03, safely above the expected p at eps_xx = 0.02.
!
! Model:
!   One SOLID185 unit cube, 1 x 1 x 1 mm.
!   Symmetry constraints on x=0, y=0, z=0.
!   Prescribed UX=0.02 mm on x=1, ramped over 100 substeps.
!   This gives a homogeneous uniaxial-stress state with free transverse
!   contraction (sigma_yy ~ sigma_zz ~ 0).
!
! Output:
!   swift_validation_ansys.csv
!   columns: substep,eps_xx,sigma_xx,sigma_yy,sigma_zz,seqv,p_eq,ux
! ======================================================================

/CLEAR
/FILNAME,swift_validation_ansys,1
/TITLE,Swift J2 one-element validation

/PREP7

! ----------------------------------------------------------------------
! Parameters
! ----------------------------------------------------------------------
EMOD    = 210000.0
NU      = 0.3
KSWIFT  = 1000.0
EPS0    = 0.01
NSWIFT  = 0.2
LENGTH  = 1.0
UMAX    = 0.02
NSUB    = 100

! ----------------------------------------------------------------------
! Element and elastic material
! ----------------------------------------------------------------------
ET,1,SOLID185
MP,EX,1,EMOD
MP,PRXY,1,NU

! ----------------------------------------------------------------------
! Swift hardening represented by PLASTIC,MISO
! X = accumulated equivalent plastic strain
! Y = current yield stress [MPa]
! ----------------------------------------------------------------------
TB,PLASTIC,1,,,MISO
TBPT,DEFI,0,398.107170553
TBPT,DEFI,0.00030303030303,400.491216293
TBPT,DEFI,0.000606060606061,402.819810572
TBPT,DEFI,0.000909090909091,405.095773603
TBPT,DEFI,0.00121212121212,407.321708596
TBPT,DEFI,0.00151515151515,409.50002381
TBPT,DEFI,0.00181818181818,411.632951857
TBPT,DEFI,0.00212121212121,413.722566646
TBPT,DEFI,0.00242424242424,415.770798314
TBPT,DEFI,0.00272727272727,417.779446427
TBPT,DEFI,0.0030303030303,419.750191688
TBPT,DEFI,0.00333333333333,421.684606343
TBPT,DEFI,0.00363636363636,423.584163467
TBPT,DEFI,0.00393939393939,425.450245269
TBPT,DEFI,0.00424242424242,427.284150533
TBPT,DEFI,0.00454545454545,429.087101309
TBPT,DEFI,0.00484848484848,430.860248935
TBPT,DEFI,0.00515151515152,432.604679485
TBPT,DEFI,0.00545454545455,434.321418682
TBPT,DEFI,0.00575757575758,436.011436368
TBPT,DEFI,0.00606060606061,437.675650553
TBPT,DEFI,0.00636363636364,439.314931104
TBPT,DEFI,0.00666666666667,440.930103111
TBPT,DEFI,0.0069696969697,442.521949956
TBPT,DEFI,0.00727272727273,444.091216126
TBPT,DEFI,0.00757575757576,445.638609788
TBPT,DEFI,0.00787878787879,447.164805149
TBPT,DEFI,0.00818181818182,448.670444635
TBPT,DEFI,0.00848484848485,450.156140885
TBPT,DEFI,0.00878787878788,451.622478599
TBPT,DEFI,0.00909090909091,453.070016237
TBPT,DEFI,0.00939393939394,454.499287593
TBPT,DEFI,0.00969696969697,455.910803249
TBPT,DEFI,0.01,457.305051927
TBPT,DEFI,0.010303030303,458.682501739
TBPT,DEFI,0.0106060606061,460.043601346
TBPT,DEFI,0.0109090909091,461.388781044
TBPT,DEFI,0.0112121212121,462.718453764
TBPT,DEFI,0.0115151515152,464.033016015
TBPT,DEFI,0.0118181818182,465.332848754
TBPT,DEFI,0.0121212121212,466.618318205
TBPT,DEFI,0.0124242424242,467.889776618
TBPT,DEFI,0.0127272727273,469.147562989
TBPT,DEFI,0.0130303030303,470.392003721
TBPT,DEFI,0.0133333333333,471.623413257
TBPT,DEFI,0.0136363636364,472.842094661
TBPT,DEFI,0.0139393939394,474.048340174
TBPT,DEFI,0.0142424242424,475.242431731
TBPT,DEFI,0.0145454545455,476.424641448
TBPT,DEFI,0.0148484848485,477.595232079
TBPT,DEFI,0.0151515151515,478.754457449
TBPT,DEFI,0.0154545454545,479.902562863
TBPT,DEFI,0.0157575757576,481.039785484
TBPT,DEFI,0.0160606060606,482.166354702
TBPT,DEFI,0.0163636363636,483.282492471
TBPT,DEFI,0.0166666666667,484.388413633
TBPT,DEFI,0.0169696969697,485.484326228
TBPT,DEFI,0.0172727272727,486.570431777
TBPT,DEFI,0.0175757575758,487.64692556
TBPT,DEFI,0.0178787878788,488.713996874
TBPT,DEFI,0.0181818181818,489.771829279
TBPT,DEFI,0.0184848484848,490.820600834
TBPT,DEFI,0.0187878787879,491.860484314
TBPT,DEFI,0.0190909090909,492.891647424
TBPT,DEFI,0.0193939393939,493.914252997
TBPT,DEFI,0.019696969697,494.928459185
TBPT,DEFI,0.02,495.934419641
TBPT,DEFI,0.020303030303,496.932283688
TBPT,DEFI,0.0206060606061,497.922196484
TBPT,DEFI,0.0209090909091,498.90429918
TBPT,DEFI,0.0212121212121,499.878729066
TBPT,DEFI,0.0215151515152,500.845619716
TBPT,DEFI,0.0218181818182,501.805101119
TBPT,DEFI,0.0221212121212,502.757299813
TBPT,DEFI,0.0224242424242,503.702339003
TBPT,DEFI,0.0227272727273,504.640338685
TBPT,DEFI,0.0230303030303,505.571415754
TBPT,DEFI,0.0233333333333,506.495684112
TBPT,DEFI,0.0236363636364,507.413254775
TBPT,DEFI,0.0239393939394,508.324235965
TBPT,DEFI,0.0242424242424,509.22873321
TBPT,DEFI,0.0245454545455,510.126849433
TBPT,DEFI,0.0248484848485,511.018685036
TBPT,DEFI,0.0251515151515,511.904337986
TBPT,DEFI,0.0254545454545,512.783903894
TBPT,DEFI,0.0257575757576,513.657476087
TBPT,DEFI,0.0260606060606,514.52514569
TBPT,DEFI,0.0263636363636,515.387001688
TBPT,DEFI,0.0266666666667,516.243130996
TBPT,DEFI,0.0269696969697,517.093618527
TBPT,DEFI,0.0272727272727,517.938547248
TBPT,DEFI,0.0275757575758,518.777998247
TBPT,DEFI,0.0278787878788,519.612050784
TBPT,DEFI,0.0281818181818,520.44078235
TBPT,DEFI,0.0284848484848,521.264268721
TBPT,DEFI,0.0287878787879,522.082584005
TBPT,DEFI,0.0290909090909,522.895800696
TBPT,DEFI,0.0293939393939,523.703989717
TBPT,DEFI,0.029696969697,524.507220471
TBPT,DEFI,0.03,525.305560881

! ----------------------------------------------------------------------
! Unit cube mesh: one SOLID185 element
! Node ordering follows the standard 8-node brick topology.
! ----------------------------------------------------------------------
N,1,0,0,0
N,2,1,0,0
N,3,1,1,0
N,4,0,1,0
N,5,0,0,1
N,6,1,0,1
N,7,1,1,1
N,8,0,1,1

TYPE,1
MAT,1
E,1,2,3,4,5,6,7,8

! ----------------------------------------------------------------------
! Boundary conditions
!
! x=0: UX=0       (symmetry)
! y=0: UY=0       (symmetry)
! z=0: UZ=0       (symmetry)
!
! The x=1 face receives a uniform prescribed UX. UY and UZ remain free,
! so the element may contract laterally.
! ----------------------------------------------------------------------
NSEL,S,LOC,X,0
D,ALL,UX,0
ALLSEL,ALL

NSEL,S,LOC,Y,0
D,ALL,UY,0
ALLSEL,ALL

NSEL,S,LOC,Z,0
D,ALL,UZ,0
ALLSEL,ALL

NSEL,S,LOC,X,1
D,ALL,UX,UMAX
ALLSEL,ALL

FINISH

! ======================================================================
! Solution
! ======================================================================
/SOLU
ANTYPE,STATIC
NLGEOM,OFF
KBC,0
AUTOTS,OFF
NSUBST,NSUB,NSUB,NSUB

! Tight equilibrium tolerance for a constitutive validation problem.
CNVTOL,F,,1.0E-10,2

! Store every substep so the complete stress-strain path can be exported.
OUTRES,ALL,ALL

TIME,1.0
SOLVE
FINISH

! ======================================================================
! Postprocessing and CSV export
! ======================================================================
/POST1

! Element-table quantities at the single element.
! NL,EPEQ is accumulated equivalent plastic strain for nonlinear material.
ETABLE,SX,S,X
ETABLE,SY,S,Y
ETABLE,SZ,S,Z
ETABLE,SEQV,S,EQV
ETABLE,PEEQ,NL,EPEQ

! Open CSV output in the working directory.
*CFOPEN,swift_validation_ansys,csv
*VWRITE,
('substep,eps_xx,sigma_xx,sigma_yy,sigma_zz,seqv,p_eq,ux')

*DO,ISUB,1,NSUB
    SET,1,ISUB

    ! Refresh element-table data for the active result set.
    ETABLE,REFL

    *GET,SXX,ELEM,1,ETAB,SX
    *GET,SYY,ELEM,1,ETAB,SY
    *GET,SZZ,ELEM,1,ETAB,SZ
    *GET,SEQ,ELEM,1,ETAB,SEQV
    *GET,PEQ,ELEM,1,ETAB,PEEQ

    ! UX is identical on all nodes of x=1. Read node 2.
    *GET,UXVAL,NODE,2,U,X
    EPSXX = UXVAL/LENGTH

    *VWRITE,ISUB,EPSXX,SXX,SYY,SZZ,SEQ,PEQ,UXVAL
    (F4.0,',',E22.14,',',E22.14,',',E22.14,',',E22.14,',',E22.14,',',E22.14,',',E22.14)
*ENDDO

*CFCLOS

! Also print the final state to the normal ANSYS output for quick checking.
SET,LAST
ETABLE,REFL
*GET,SXXF,ELEM,1,ETAB,SX
*GET,SYYF,ELEM,1,ETAB,SY
*GET,SZZF,ELEM,1,ETAB,SZ
*GET,SEQF,ELEM,1,ETAB,SEQV
*GET,PEQF,ELEM,1,ETAB,PEEQ
*GET,UXF,NODE,2,U,X
EPSXXF=UXF/LENGTH

/COM,============================================================
/COM, Final Swift validation state
/COM,============================================================
*VWRITE,EPSXXF,SXXF,SYYF,SZZF,SEQF,PEQF
(' eps_xx=',E16.8,'  sxx=',E16.8,'  syy=',E16.8,'  szz=',E16.8,'  seqv=',E16.8,'  p_eq=',E16.8)

FINISH

! End of input file
